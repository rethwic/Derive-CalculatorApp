{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* nodenext, not bundler — Vercel Functions here run each file
       individually under Node's own ESM loader at runtime (confirmed via
       an ERR_MODULE_NOT_FOUND from a bare specifier in production), not a
       single esbuild-bundled file, so this needs to type-check against the
       same resolution rules that will actually execute it: relative
       imports require an explicit .js extension even though the source
       is .ts. */
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["api"]
}
